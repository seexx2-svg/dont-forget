/* app.wxss - 全局样式 */

/* ===== 色彩变量 ===== */
page {
  --color-primary: #4ECDC4;
  --color-primary-light: #E8F8F7;
  --color-danger: #FF6B6B;
  --color-warning: #FFA94D;
  --color-success: #51CF66;
  --color-text: #333333;
  --color-text-secondary: #888888;
  --color-text-placeholder: #BBBBBB;
  --color-bg: #F5F6FA;
  --color-card: #FFFFFF;
  --color-border: #EEEEEE;

  /* 分类色 */
  --cat-bill: #FF6B6B;
  --cat-health: #4ECDC4;
  --cat-idcard: #45B7D1;
  --cat-anniversary: #FF8CC8;

  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  box-sizing: border-box;
}

view, text, scroll-view, swiper, swiper-item, navigator {
  box-sizing: border-box;
}

/* ===== 通用布局 ===== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* ===== 卡片 ===== */
.card {
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ===== 文字 ===== */
.text-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
}

.text-subtitle {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.text-secondary {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.text-placeholder {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

.text-danger {
  color: var(--color-danger);
}

.text-primary {
  color: var(--color-primary);
}

/* ===== 按钮 ===== */
.btn-primary {
  background: var(--color-primary);
  color: #FFFFFF;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

/* ===== 浮动添加按钮 ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(78, 205, 196, 0.4);
  z-index: 100;
}

/* ===== 标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state .empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: var(--color-text-placeholder);
}

/* ===== 安全区 ===== */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 20rpx 0;
}
