/* pages/add/add.wxss - 添加/编辑提醒页样式 */

.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  background: var(--color-bg);
}

/* ===== 区块标题 ===== */
.section-title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  margin: 8rpx 8rpx 16rpx;
}

/* ===== 分类选择区 ===== */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.category-list {
  display: flex;
  flex-direction: row;
  padding-bottom: 8rpx;
}

.category-card {
  flex-shrink: 0;
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin-right: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  transition: all 0.2s;
}

.category-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 22rpx;
  color: var(--color-text);
  text-align: center;
}

.category-active {
  transform: translateY(-4rpx);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* ===== 子类型选择区 ===== */
.subtype-card {
  padding: 24rpx 12rpx;
}

.subtype-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.subtype-item {
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  margin: 8rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background: #F9FAFC;
  transition: all 0.2s;
}

.subtype-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.subtype-icon {
  font-size: 30rpx;
}

.subtype-label {
  font-size: 22rpx;
  color: var(--color-text);
  text-align: center;
}

.subtype-active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.subtype-active .subtype-icon-wrap {
  background: var(--color-primary);
}

.subtype-active .subtype-label {
  color: var(--color-primary);
  font-weight: 600;
}

/* ===== 表单卡片 ===== */
.form-card {
  padding: 12rpx 28rpx;
}

.form-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 0;
}

.form-item-top {
  min-height: 0;
  padding-bottom: 0;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
}

.form-placeholder {
  color: var(--color-text-placeholder);
  font-size: 28rpx;
}

.form-value-row {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}

.form-value {
  font-size: 28rpx;
  color: var(--color-text);
}

.fuzzy-date-value {
  color: #4ECDC4;
  font-weight: 600;
}

.form-hint {
  font-size: 22rpx;
  color: var(--color-primary);
  margin-left: 12rpx;
}

.form-arrow {
  font-size: 32rpx;
  color: var(--color-text-placeholder);
  margin-left: 12rpx;
  line-height: 1;
}

.form-divider {
  height: 1rpx;
  background: var(--color-border);
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.6;
  padding: 8rpx 0 16rpx;
  box-sizing: border-box;
}

/* ===== 农历设置区 ===== */
.lunar-card {
  background: linear-gradient(135deg, #FFF8F0 0%, #FFFFFF 100%);
  padding: 12rpx 28rpx;
  transition: opacity 0.2s;
}

.lunar-disabled {
  opacity: 0.6;
}

.lunar-switch-item {
  justify-content: space-between;
}

.lunar-switch-left {
  display: flex;
  flex-direction: column;
}

.lunar-tip {
  font-size: 20rpx;
  color: var(--color-text-placeholder);
  margin-top: 4rpx;
}

/* ===== 底部按钮区 ===== */
.bottom-placeholder {
  height: 240rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  z-index: 50;
}

.save-btn {
  width: 100%;
  margin-bottom: 16rpx;
}

.delete-btn {
  width: 100%;
  color: var(--color-danger);
  border-color: var(--color-danger);
}

/* ===== AI 智能识别大卡片 ===== */
.ai-hero {
  background: linear-gradient(135deg, #E8F8FF 0%, #F5F0FF 100%);
  padding: 32rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.ai-hero-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.ai-hero-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E50;
  background: linear-gradient(90deg, #4ECDC4, #5B8DEF);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.ai-hero-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

/* 大语音按钮 */
.ai-voice-large {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 32rpx;
  transition: transform 0.15s ease-out;
}

.ai-voice-large-rec {
  transform: scale(1.05);
}

.ai-voice-large-disabled {
  opacity: 0.6;
}

.ai-voice-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #FFFFFF 0%, #E0F7F5 60%, #B8EDE8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(78, 205, 196, 0.25);
  border: 6rpx solid #FFFFFF;
  position: relative;
  transition: all 0.2s;
}

.ai-voice-ring-active {
  background: radial-gradient(circle at 30% 30%, #FF6B6B 0%, #E84A4A 100%);
  box-shadow: 0 0 0 16rpx rgba(255, 107, 107, 0.15), 0 8rpx 40rpx rgba(255, 107, 107, 0.5);
  animation: voicePulse 1.2s ease-in-out infinite;
}

@keyframes voicePulse {
  0%, 100% { box-shadow: 0 0 0 16rpx rgba(255, 107, 107, 0.15), 0 8rpx 40rpx rgba(255, 107, 107, 0.5); }
  50% { box-shadow: 0 0 0 28rpx rgba(255, 107, 107, 0.05), 0 8rpx 40rpx rgba(255, 107, 107, 0.7); }
}

.ai-voice-emoji {
  font-size: 80rpx;
  line-height: 1;
}

.ai-voice-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-top: 20rpx;
}

/* 文字输入切换 */
.ai-text-toggle {
  text-align: center;
  padding: 16rpx 0 8rpx;
}

.ai-text-toggle text {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 文字输入区 */
.ai-text-wrap {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.ai-input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.ai-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
  padding: 12rpx 0;
  margin-right: 16rpx;
}

.ai-parse-btn {
  background: var(--color-primary);
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.ai-parse-btn-disabled {
  opacity: 0.6;
}

.ai-parse-btn-text {
  color: #FFFFFF;
  font-size: 26rpx;
}

/* 提示信息 */
.ai-tip-row {
  margin-top: 12rpx;
  padding: 0 8rpx;
}

.ai-tip {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ===== 录音全屏遮罩 ===== */
.voice-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-mask-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 64rpx;
  border-radius: 28rpx;
  background: rgba(33, 33, 40, 0.85);
  min-width: 400rpx;
}

.voice-mask-tip {
  color: #FFFFFF;
  font-size: 28rpx;
  margin-top: 24rpx;
}

.voice-mask-text {
  color: #B0BEC5;
  font-size: 24rpx;
  margin-top: 12rpx;
  max-width: 600rpx;
  text-align: center;
  word-break: break-all;
}

/* ===== 语音输入波形 ===== */
.voice-wave {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  gap: 10rpx;
}

.voice-wave-bar {
  width: 8rpx;
  height: 16rpx;
  background: #4ECDC4;
  border-radius: 4rpx;
  transition: height 0.2s;
}

.voice-wave-active .voice-wave-bar {
  animation: voiceWave 0.9s ease-in-out infinite;
  background: #FF6B6B;
}

.voice-wave-active .voice-wave-bar:nth-child(1) { animation-delay: 0s; }
.voice-wave-active .voice-wave-bar:nth-child(2) { animation-delay: 0.15s; }
.voice-wave-active .voice-wave-bar:nth-child(3) { animation-delay: 0.3s; }
.voice-wave-active .voice-wave-bar:nth-child(4) { animation-delay: 0.45s; }
.voice-wave-active .voice-wave-bar:nth-child(5) { animation-delay: 0.6s; }

@keyframes voiceWave {
  0%, 100% { height: 16rpx; }
  50% { height: 60rpx; }
}

/* ===== 模糊日期卡片 ===== */
.fuzzy-card {
  background: linear-gradient(135deg, #F0F7FF 0%, #FFFFFF 100%);
  padding: 20rpx 28rpx 12rpx;
  margin-top: -4rpx;
}

.fuzzy-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-bottom: 8rpx;
}

.fuzzy-title-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.fuzzy-title-text {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.fuzzy-tip-row {
  padding: 8rpx 0 4rpx;
}

.fuzzy-tip-text {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
