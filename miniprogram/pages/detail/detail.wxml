<!--pages/detail/detail.wxml - 提醒详情页-->
<view class="page" wx:if="{{!isLoading && reminder}}">
  <!-- 顶部卡片区域 -->
  <view
    class="hero"
    style="background: linear-gradient(135deg, {{reminder.categoryColor}} 0%, {{reminder.categoryColor}}CC 100%);"
  >
    <view class="hero-icon" style="background: rgba(255,255,255,0.25);">
      <text>{{reminder.categoryIcon}}</text>
    </view>
    <text class="hero-title">{{reminder.title}}</text>
    <view class="hero-tags">
      <view class="hero-tag">{{reminder.categoryName}}</view>
      <view class="hero-tag" wx:if="{{reminder.subTypeLabel}}">
        <text class="hero-tag-icon">{{reminder.subTypeIcon}}</text>
        <text>{{reminder.subTypeLabel}}</text>
      </view>
    </view>

    <view class="countdown-block">
      <text class="countdown-num">{{countdownText}}</text>
      <text class="countdown-sub">{{countdownSub}}</text>
    </view>

    <view class="hero-done-badge" wx:if="{{reminder.done}}">已完成</view>
  </view>

  <!-- 信息列表卡片 -->
  <view class="card info-card">
    <view class="info-item">
      <text class="info-label">提醒日期</text>
      <view class="info-value-wrap">
        <text class="info-value">{{reminder.fuzzyDateDesc || reminder.remindDate}}</text>
        <text class="info-extra">{{reminder.fuzzyDateDesc ? '下次到期 ' + reminder.friendlyDate : reminder.friendlyDate}}</text>
      </view>
    </view>

    <view class="info-divider"></view>

    <view class="info-item">
      <text class="info-label">提醒时间</text>
      <text class="info-value">{{reminder.remindTime}}</text>
    </view>

    <view class="info-divider"></view>

    <view class="info-item">
      <text class="info-label">提前提醒</text>
      <text class="info-value">{{advanceLabel}}</text>
    </view>

    <view class="info-divider"></view>

    <view class="info-item">
      <text class="info-label">重复类型</text>
      <text class="info-value">{{reminder.repeatLabel}}</text>
    </view>

    <block wx:if="{{reminder.fuzzyDateDesc}}">
      <view class="info-divider"></view>
      <view class="info-item">
        <text class="info-label">重复规则</text>
        <text class="info-value">{{reminder.fuzzyDateDesc}}</text>
      </view>
    </block>

    <block wx:if="{{reminder.isLunar && reminder.lunarDesc}}">
      <view class="info-divider"></view>
      <view class="info-item">
        <text class="info-label">农历信息</text>
        <text class="info-value">{{reminder.lunarDesc}}</text>
      </view>
    </block>

    <view class="info-divider"></view>

    <view class="info-item">
      <text class="info-label">创建时间</text>
      <text class="info-value">{{createdDate}}</text>
    </view>

    <block wx:if="{{reminder.note}}">
      <view class="info-divider"></view>
      <view class="info-item info-item-col">
        <text class="info-label">备注</text>
        <text class="info-note">{{reminder.note}}</text>
      </view>
    </block>
  </view>

  <!-- 占位，避免底部操作栏遮挡 -->
  <view class="bottom-placeholder"></view>

  <!-- 底部操作区 -->
  <view class="action-bar safe-bottom">
    <!-- 订阅推送按钮 -->
    <view class="subscribe-row" wx:if="{{needSubscribe}}">
      <view class="subscribe-btn" bindtap="onSubscribe">
        <text class="subscribe-icon">🔔</text>
        <text>开启提醒推送</text>
      </view>
    </view>

    <view class="action-row">
      <!-- 完成/取消完成 -->
      <view class="action-item" bindtap="onToggleDone">
        <view class="action-circle {{reminder.done ? 'action-done' : ''}}">
          <text wx:if="{{reminder.done}}" class="check-icon">✓</text>
        </view>
        <text class="action-text">{{reminder.done ? '已完成' : '完成'}}</text>
      </view>

      <!-- 编辑 -->
      <view class="action-item" bindtap="onEdit">
        <view class="action-circle action-edit">
          <text class="action-emoji">✎</text>
        </view>
        <text class="action-text">编辑</text>
      </view>

      <!-- 删除 -->
      <view class="action-item" bindtap="onDelete">
        <view class="action-circle action-delete">
          <text class="action-emoji">🗑</text>
        </view>
        <text class="action-text text-danger">删除</text>
      </view>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-state" wx:if="{{isLoading}}">
  <text class="loading-text">加载中...</text>
</view>

<!-- 提醒不存在 -->
<view class="empty-state" wx:if="{{!isLoading && !reminder}}">
  <text class="empty-icon">😕</text>
  <text class="empty-text">提醒不存在或已删除</text>
</view>
