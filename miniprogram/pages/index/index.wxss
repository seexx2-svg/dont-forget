/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部渐变欢迎区 */
.header {
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7D1 100%);
  padding: 40rpx 32rpx 70rpx;
  color: #FFFFFF;
}

.header-top {
  display: flex;
  flex-direction: column;
  margin-bottom: 40rpx;
}

.greeting {
  font-size: 28rpx;
  opacity: 0.9;
}

.header-date {
  font-size: 44rpx;
  font-weight: 600;
  margin-top: 10rpx;
}

/* 统计卡片横排 */
.stats-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 26rpx 0;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.num-danger {
  color: #FFE0E0;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

/* Tab 切换栏 */
.tab-bar {
  display: flex;
  flex-direction: row;
  background: #FFFFFF;
  margin: -36rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 6rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 2;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  position: relative;
}

.tab-active {
  color: var(--color-primary);
  font-weight: 600;
}

/* 选中底部下划线指示器 */
.tab-active::after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

.tab-badge {
  margin-left: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #FFFFFF;
}

.badge-danger {
  background: var(--color-danger);
}

/* 列表区域 */
.list-wrap {
  padding: 24rpx;
}

/* 浮动按钮组 */
.fab-group {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  z-index: 100;
}

/* 浮动按钮文字 */
.fab text {
  color: #FFFFFF;
  font-size: 56rpx;
  line-height: 1;
}

/* 🔔 推送按钮（紫色，区分于添加按钮） */
.fab-notify {
  background: linear-gradient(135deg, #9B59B6 0%, #8E44AD 100%);
  box-shadow: 0 8rpx 32rpx rgba(155, 89, 182, 0.4);
}

/* ===== 隐私锁拦截弹窗 ===== */
.lock-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.lock-card {
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 56rpx 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lock-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}

.lock-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.lock-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 40rpx;
  text-align: center;
}

.lock-input-box {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.lock-input {
  width: 400rpx;
  height: 96rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  text-align: center;
  font-size: 48rpx;
  letter-spacing: 32rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

.lock-btn {
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
}
